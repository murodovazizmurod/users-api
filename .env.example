# Copy to .env and adjust. Everything here has a working default for local use.
# Comments must be on their own line: a trailing "# ..." after an empty value
# is parsed as part of that value.

# --- General ---------------------------------------------------------------
PROJECT_NAME=Users API
# dev | test | prod
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
# Leave empty for the endpoints in the specification, or set e.g. /api/v1
API_PREFIX=
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# Docker Compose overrides the host to "db"; use localhost when running natively.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/users_api
# Zero-dependency alternative:
# DATABASE_URL=sqlite+aiosqlite:///./users_api.db
DB_ECHO=false

# Consumed by the postgres service in docker-compose.yml.
# Change POSTGRES_PORT if 5432 is already taken on the host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=users_api
POSTGRES_PORT=5432
API_PORT=8000

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-development-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Verification ----------------------------------------------------------
# email | sms
VERIFICATION_CHANNEL=email
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5

# --- Retention -------------------------------------------------------------
UNVERIFIED_USER_TTL_DAYS=2
CLEANUP_INTERVAL_MINUTES=60

# --- Celery ----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Bootstrap admin -------------------------------------------------------
# Created on first startup when no admin exists yet. Leave blank to skip.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin12345
